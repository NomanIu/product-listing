# Copy this file to `.env` and fill in your own values.

# PostgreSQL connection string (this project was built against Neon).
# Neon: Project dashboard -> Connection string. Keep `sslmode=require`.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Public origin of the deployed site. Used to build absolute URLs in JSON-LD.
# In local development the default (http://localhost:3000) is fine.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Base URL of the product REST API. Optional — defaults to https://dummyjson.com.
# PRODUCT_API_BASE_URL="https://dummyjson.com"
